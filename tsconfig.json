{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "esnext"
                                    ],
                            "allowJs":  false,
                            "skipLibCheck":  true,
                            "strict":  true,
                            "noEmit":  true,
                            "esModuleInterop":  true,
                            "module":  "esnext",
                            "moduleResolution":  "bundler",
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "jsx":  "react-jsx",
                            "incremental":  true,
                            "plugins":  [
                                            {
                                                "name":  "next"
                                            }
                                        ],
                            "types":  [
                                          "node",
                                          "vitest/globals"
                                      ]
                        },
    "include":  [
                    "next-env.d.ts",
                    "app/**/*.ts",
                    "app/**/*.tsx",
                    "src/**/*.ts",
                    "src/**/*.tsx",
                    ".next/types/**/*.ts",
                    ".next/dev/types/**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "backend",
                    "src/main.tsx",
                    "src/App.tsx"
                ]
}